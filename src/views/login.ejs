<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Aplicación de Nómina</title>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; padding: 0; display: flex; flex-direction: column; min-height: 100vh; }
        
        /* Franja superior de líneas nacionales */
        .top-bar {
            background-color: #0f172a;
            color: #94a3b8;
            font-size: 0.8rem;
            padding: 8px 30px;
            border-bottom: 1px solid #1e293b;
            letter-spacing: 0.02em;
        }

        /* Barra de Navegación */
        nav { background: #1e293b; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; }
        .logo { font-weight: bold; font-size: 1.25rem; color: #38bdf8; display: flex; align-items: center; gap: 8px; text-decoration: none; }
        .nav-links { display: flex; gap: 20px; align-items: center; }
        .nav-links a { color: #cbd5e1; text-decoration: none; font-weight: 500; transition: color 0.2s; }
        .nav-links a:hover { color: #38bdf8; }

        /* Contenedor principal centrado para el formulario */
        .login-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .login-card { 
            background: #111c30; 
            padding: 40px; 
            border-radius: 20px; 
            box-shadow: 0 25px 35px -10px rgba(0, 0, 0, 0.4); 
            width: 100%; 
            max-width: 400px; 
            border: 1px solid #334155; 
        }
        .login-card h2 { color: #ffffff; margin-bottom: 10px; font-size: 2rem; text-align: center; }
        .login-card h2 span { color: #38bdf8; }
        .login-card p { color: #94a3b8; text-align: center; margin-bottom: 30px; font-size: 0.95rem; }
        
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; color: #cbd5e1; font-weight: 500; font-size: 0.9rem; }
        .form-group input { width: 100%; padding: 12px 16px; background: #0f172a; border: 1px solid #475569; border-radius: 8px; color: #ffffff; font-size: 1rem; box-sizing: border-box; transition: border-color 0.2s; }
        .form-group input:focus { outline: none; border-color: #38bdf8; }
        
        .btn-submit { width: 100%; background: #38bdf8; color: #0f172a; padding: 12px; border: none; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; transition: background 0.2s; margin-top: 10px; }
        .btn-submit:hover { background: #0ea5e9; }
        
        .error-message {
            background: rgba(239, 68, 68, 0.1); 
            border: 1px solid rgba(239, 68, 68, 0.3); 
            color: #f87171; 
            padding: 10px; 
            border-radius: 6px; 
            margin-bottom: 20px; 
            font-size: 0.9rem; 
            text-align: center;
        }
    </style>
</head>
<body>

    <!-- Franja Superior -->
    <div class="top-bar">
        Líneas nacionales: 316 301 6937 - 300 669 6513 - 318 206 4911
    </div>

    <!-- Barra de Navegación -->
    <nav>
        <a href="/" class="logo">⚡ Aplicación Nómina</a>
        <div class="nav-links">
            <a href="/">← Volver al inicio</a>
        </div>
    </nav>

    <!-- Contenido del Login -->
    <div class="login-container">
        <div class="login-card">
            <h2>Iniciar <span>Sesión</span></h2>
            <p>Accede al panel de control de nómina</p>
            
            <% if (locals.error && error) { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST">
                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" name="email" required placeholder="admin@empresa.com">
                </div>
                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" required placeholder="••••••••">
                </div>
                <button type="submit" class="btn-submit">Ingresar</button>
            </form>
        </div>
    </div>

</body>
</html>