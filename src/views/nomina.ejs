<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Nómina</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #121212; color: #e0e0e0; margin: 0; padding: 20px; }
        .container { max-width: 800px; margin: auto; background: #1e1e1e; padding: 20px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.3); }
        h1, h2 { color: #ffffff; text-align: center; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; border-bottom: 1px solid #333; text-align: left; }
        th { background-color: #2c2c2c; color: #ffffff; }
        .total-row { font-weight: bold; background-color: #252525; }
    </style>
</head>
<body>
    <%- include('partials/nav') %>
    <div class="container">
        <h1>Resumen de Nómina</h1>
        <% if (locals.employee) { %>
            <p><strong>Empleado:</strong> <%= employee.nombre || 'N/A' %></p>
        <% } %>

        <table>
            <tr>
                <th>Concepto</th>
                <th>Monto</th>
            </tr>
            <tr>
                <td>Salario Bruto</td>
                <td>$<%= nomina.salario_bruto.toFixed(2) %></td>
            </tr>
            <tr>
                <td>Impuesto ISR</td>
                <td>-$<%= nomina.impuesto_isr.toFixed(2) %></td>
            </tr>
            <tr>
                <td>IMSS</td>
                <td>-$<%= nomina.imss.toFixed(2) %></td>
            </tr>
            <tr>
                <td>Otras Deducciones</td>
                <td>-$<%= nomina.otras_deducciones.toFixed(2) %></td>
            </tr>
            <tr class="total-row">
                <td>Total Deducciones</td>
                <td>-$<%= nomina.total_deducciones.toFixed(2) %></td>
            </tr>
            <tr class="total-row" style="color: #4caf50;">
                <td>Salario Neto a Pagar</td>
                <td>$<%= nomina.salario_neto.toFixed(2) %></td>
            </tr>
        </table>
    </div>
</body>
</html>